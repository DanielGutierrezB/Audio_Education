{
  "name": "audiopro",
  "version": "0.6.7",
  "description": "Professional voice processing for educational content",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "setup:bin": "bash scripts/fetch-bin.sh",
    "setup:bin:win": "powershell -ExecutionPolicy Bypass -File scripts/fetch-bin.ps1",
    "build": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win --x64",
    "build:icon": "rsvg-convert -w 512 -h 512 build/icon.svg -o build/icons/512x512.png && rsvg-convert -w 1024 -h 1024 build/icon.svg -o build/icons/1024x1024.png || (convert build/icon.svg -resize 512x512 build/icons/512x512.png && convert build/icon.svg -resize 1024x1024 build/icons/1024x1024.png)"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.platzi.audiopro",
    "productName": "AudioPro",
    "icon": "build/icon.icns",
    "publish": {
      "provider": "github",
      "owner": "DanielGutierrezB",
      "repo": "audio_education",
      "releaseType": "release"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "pkg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "pkg": {
      "installLocation": "/Applications",
      "isRelocatable": false,
      "overwriteAction": "upgrade",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "scripts": "pkg-scripts"
    },
    "win": {
      "icon": "build/icons/1024x1024.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AudioPro"
    }
  }
}
